{
  // Solution file for `tsc -b`. Its absence is why `pnpm typecheck` and `pnpm build` — both
  // `tsc -b` — failed with TS5083 ("Cannot read file '.../tsconfig.json'") and exited 1 on every
  // invocation. CI never ran either, so no stage in this repo type-checked anything: vitest runs
  // through esbuild, which transpiles without checking, and there is no linter.
  //
  // `files: []` is deliberate — this project compiles nothing itself, it only orders the graph.
  // Every package with TypeScript is referenced below. `packages/widget` was excluded here
  // because it used to be just `public/index.html` + a package.json, no .ts; it gained
  // `src/loader-core.ts` in the embeddable-widget work, so it's referenced now too.
  "files": [],
  "references": [
    { "path": "packages/platform-ports/tsconfig.json" },
    { "path": "packages/widget-brain/tsconfig.json" },
    { "path": "packages/model-vertex/tsconfig.json" },
    { "path": "packages/widget-memory/tsconfig.json" },
    { "path": "packages/state-postgres/tsconfig.json" },
    { "path": "packages/widget-backend/tsconfig.json" },
    { "path": "packages/judge/tsconfig.json" },
    { "path": "packages/evolution/tsconfig.json" },
    { "path": "packages/eval/tsconfig.json" },
    { "path": "packages/control-plane/tsconfig.json" },
    { "path": "packages/widget/tsconfig.json" },
    { "path": "packages/identity-shopify/tsconfig.json" }
  ]
}
