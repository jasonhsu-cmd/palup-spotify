{
  "name": "palup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "PGVECTOR_TESTCONTAINER=off vitest run",
    "test:watch": "vitest",
    "eval": "tsx packages/eval/src/run.ts",
    "eval:judge": "tsx packages/eval/src/judge-run.ts",
    "eval:full": "tsx packages/eval/src/eval-full.ts",
    "eval:regression": "tsx packages/eval/src/regression-check.ts",
    "eval:money-facts": "tsx packages/eval/src/eval-money-facts.ts",
    "eval:offer-check": "tsx packages/eval/src/eval-offer-check.ts",
    "eval:guard-classifier": "tsx packages/widget-backend/src/eval-guard-classifier.ts",
    "eval:retrieval": "tsx packages/widget-backend/src/eval-retrieval.ts",
    "shadow:offer-check": "tsx packages/eval/src/shadow-offer-check.ts",
    "shadow:guard-signals": "tsx packages/eval/src/shadow-guard-signals.ts",
    "shadow:retrieval": "tsx packages/eval/src/shadow-retrieval.ts",
    "shadow:hydration": "tsx packages/eval/src/shadow-hydration.ts",
    "evo:demo": "tsx packages/evolution/src/demo.ts",
    "evolve": "tsx packages/control-plane/src/evolve.ts",
    "try": "tsx packages/control-plane/src/try.ts",
    "monitor": "tsx packages/control-plane/src/server.ts",
    "model:smoke": "tsx packages/model-vertex/src/smoke.ts",
    "shopify:verify": "tsx packages/widget-backend/src/shopify-verify-smoke.ts",
    "push:smoke": "tsx packages/widget-backend/src/pubsub-push-smoke.ts",
    "backend": "tsx packages/widget-backend/src/server.ts",
    "sweep": "tsx packages/widget-backend/src/jobs/retention-sweep.ts",
    "kill:arm": "tsx packages/widget-backend/src/jobs/kill-switch.ts arm",
    "kill:status": "tsx packages/widget-backend/src/jobs/kill-switch.ts status",
    "kill:disarm": "tsx packages/widget-backend/src/jobs/kill-switch.ts disarm",
    "cap:set": "tsx packages/widget-backend/src/jobs/cost-cap.ts set",
    "cap:status": "tsx packages/widget-backend/src/jobs/cost-cap.ts status",
    "cap:clear": "tsx packages/widget-backend/src/jobs/cost-cap.ts clear",
    "catalog:index": "tsx packages/widget-backend/src/jobs/catalog-index.ts index",
    "catalog:clear": "tsx packages/widget-backend/src/jobs/catalog-index.ts clear",
    "catalog:enable": "tsx packages/widget-backend/src/jobs/catalog-enable.ts",
    "grounding:invalidate": "tsx packages/widget-backend/src/jobs/merchant.ts invalidate-grounding",
    "widget:dev": "pnpm --filter @palup/widget dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:live": "playwright test --config e2e/playwright.live.config.ts",
    "e2e:monitor": "playwright test --config e2e/playwright.monitor.config.ts",
    "e2e:embed": "playwright test --config e2e/playwright.embed.config.ts",
    "typecheck": "tsc -b --pretty",
    "test:pgvector": "vitest run packages/state-postgres/test/pgvector-container.smoke.test.ts packages/state-postgres/test/pgvector-store.migrate.test.ts packages/state-postgres/test/pgvector-store.upsert.test.ts packages/state-postgres/test/pgvector-store.query.test.ts packages/state-postgres/test/pgvector-store.erasure.test.ts packages/state-postgres/test/pgvector-store.contract.test.ts packages/state-postgres/test/pgvector-list.test.ts packages/state-postgres/test/vector-factory.ann.test.ts packages/widget-backend/test/catalog-index-pgvector-reconcile.test.ts packages/widget-backend/test/catalog-clear-pgvector.test.ts packages/widget-backend/test/retrieval-promotion-evidence.test.ts packages/widget-memory/test/memory-pgvector-scale.test.ts packages/widget-memory/test/service-pgvector-recall.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
