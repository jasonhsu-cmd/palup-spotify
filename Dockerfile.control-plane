# Control-plane container for staging (Cloud Run). Runs the monitor dashboard via tsx (no build
# step). Mirrors ./Dockerfile (widget backend) exactly except for the port and entrypoint — see that
# file first if you're changing this one.
FROM node:22-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true PORT=8990 HOST=0.0.0.0
RUN corepack enable
WORKDIR /app

# Install deps first (better layer caching). Needs all workspace manifests + the lockfile.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile

EXPOSE 8990
# Cloud Run sets $PORT; server.ts reads it (falls back to 8990 locally). HOST=0.0.0.0 above is what
# lets Cloud Run's network health check reach the process (server.ts otherwise defaults to the
# loopback-only 127.0.0.1 for local/dev safety).
#
# Deploy with (owner step, not run by this build):
#   gcloud run deploy <service> --source . --dockerfile Dockerfile.control-plane \
#     --no-allow-unauthenticated \
#     --set-env-vars PROMOTE_TENANT=palup-skincare-jason,OPERATOR_TOKEN=<secret>,DATABASE_URL=<secret>
# --no-allow-unauthenticated is load-bearing here: GET /api/state (and other reads) are intentionally
# left open at the app layer for the dashboard (see server.ts comments) — edge IAM is what gates them
# in this deploy. Do not change that route's auth as a side effect of wiring the container.
CMD ["pnpm", "monitor"]
