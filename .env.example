# Real model (Vertex/Gemini). Copy to .env (gitignored) and fill in.
# 1) Authenticate Application Default Credentials:  gcloud auth application-default login
# 2) Set these, then:  pnpm model:smoke   (verify live)   and   pnpm backend
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Confirm availability in your region's Model Garden.
PALUP_MODEL=gemini-2.5-flash

# Cross-family judge (optional): Anthropic direct API key enables the GATING judge with no GCP.
#   JUDGE_FAMILY=anthropic pnpm eval:judge
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
